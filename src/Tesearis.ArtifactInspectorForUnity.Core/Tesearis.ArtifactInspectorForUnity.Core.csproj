<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
        <LangVersion>9.0</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <RootNamespace>Tesearis.ArtifactInspectorForUnity.Core</RootNamespace>
        <AssemblyName>Tesearis.ArtifactInspectorForUnity.Core</AssemblyName>
        <Version>1.0.0</Version>
        <PackageId>Tesearis.ArtifactInspectorForUnity.Core</PackageId>
        <Description>Core .NET library for typed inspection of built Unity artifacts (AssetBundles, Player builds, Addressables output).</Description>
        <Authors>Tesearis</Authors>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/marek-jelo-jelinek/artifact-inspector-for-unity-core</PackageProjectUrl>
        <RepositoryUrl>https://github.com/marek-jelo-jelinek/artifact-inspector-for-unity-core</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Copyright>Copyright (c) 2026 Marek Jelínek</Copyright>
        <PackageTags>unity;unity3d;assetbundle;addressables;serialized-file</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>
    <ItemGroup>
        <None Include="../../LICENSE" Pack="true" PackagePath=""/>
        <None Include="../../README.md" Pack="true" PackagePath=""/>
        <None Include="../../ThirdPartyNotices.md" Pack="true" PackagePath=""/>
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.Buffers" Version="4.5.1"/>
        <PackageReference Include="System.Memory" Version="4.5.5"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Tesearis.ArtifactInspectorForUnity.Core.Tests"/>
    </ItemGroup>
</Project>
